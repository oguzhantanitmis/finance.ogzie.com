{
  "name": "finance.ogzie.com",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "dev": "next dev",
    "test": "vitest run",
    "prisma": "DOTENV_CONFIG_PATH=.env.local node -r dotenv/config ./node_modules/prisma/build/index.js",
    "db:generate": "prisma generate",
    "db:update": "npm run prisma -- migrate deploy && prisma generate",
    "db:push": "npm run prisma -- db push && prisma generate",
    "db:postgres:migrate": "node scripts/migrate-mariadb-to-postgres.mjs",
    "db:postgres:verify": "node scripts/migrate-mariadb-to-postgres.mjs --verify",
    "db:mariadb:backup": "node scripts/backup-mariadb.mjs",
    "build": "prisma generate && next build",
    "build:vercel": "prisma generate && next build",
    "build:production": "npm run prisma -- migrate deploy && prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.3.0",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^14.6.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^1.61.0",
    "mysql2": "^3.24.6",
    "next": "^16.4.3",
    "next-auth": "^4.24.15",
    "nodemailer10": "npm:nodemailer@^10.2.1",
    "papaparse": "^5.7.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.9",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.3",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
