# Same Node runtime pin as Dockerfile (tag + multi-arch index digest).
ARG NODE_IMAGE=node:24.22.1-alpine3.24@sha256:06d7adf3e0ef61a13f1d28682726366f97a15aa1888c934d3ecec86c33918b53
FROM ${NODE_IMAGE}

WORKDIR /app
RUN apk add --no-cache gzip mariadb-client openssl

COPY package.json package-lock.json ./
COPY prisma ./prisma
RUN npm ci --ignore-scripts

COPY scripts ./scripts

# Dokploy bu kapalı yardımcı konteynerde komutları yalnız elle çalıştırır.
# Veri kopyalama CMD/ENTRYPOINT içinde otomatik başlamaz.
CMD ["tail", "-f", "/dev/null"]
